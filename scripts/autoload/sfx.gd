extends Node
## Sound effects, music, ambience and haptics, with player settings.
## Sounds are generated by tools/audio/make_sfx.py into the pack's audio/ folder
## (effects .wav -> QOA; music and ambience .ogg, looping). The sound list,
## the mix and the owner's listening checklist: docs/polish/audio.md.
##
## Mix (sprint 2026-10-26, sound track): three buses under Master, each
## created here if the project has no bus layout:
##   Music - the music loop. Ducks while Munshi-ji's box is open, goes a
##           little quieter and darker at night (low-pass), fades in at boot.
##   SFX   - world sounds: sale, serve, pickups, cooks, horns, ambience.
##   UI    - taps, buttons, deny, Munshi-ji's typing, rewards, fanfares.
## Master gets a hard limiter, so a pile-up of sounds never clips. Master's
## volume and mute stay Main3's (background silence) and Ads' (ad open).
## SOUND OFF mutes SFX + UI at once (tails too); MUSIC OFF stops the music.
## A sound id can have variants (VARIANTS): play() picks one, never the same
## twice in a row, so the sale and serve sounds do not wear out.
##
## Feel sprint (2026-10-26, feel track):
##  - A "button_thunk" less than COVER_S after a purchase sound that has its
##    own knock (COVERS: the LEVEL UP "upgrade", which Fx's world juice plays
##    with a rising pitch through play_pitched) is skipped, so a LEVEL UP tap
##    is one sound, not two knocks.
##  - Vibration lives in Haptics (scripts/v3/core/haptics.gd, a child of Fx):
##    it pulses on purchases, claims, builds and unlocks from Game signals;
##    taps that spend nothing do not vibrate (owner decision 8, 27 Oct; the
##    old buzz() and its callers were removed in the C1 cleanup).
##    vibration_on (key "vibration") is the switch.
##
## Horn by vehicle (owner decision 9, 27 Oct): Traffic plays the vehicle's
## own horn id (horn = car, horn_truck = lorry and bus, horn_auto, bike);
## they share the "horn" cooldown (HORN_IDS).

## Sounds come from the theme pack (ThemePack.audio_dir()), then the kit's
## own (ThemePack.ENGINE_DIR + "audio/").
static var DIR: String = ThemePack.audio_dir()
## The pack's sound table (audio/sounds.json: volume_db, pitched_db,
## pitch_jitter_max, cooldown, bus, variants, horn_ids). Idle Business Kit
## phase 3: these per-file numbers belong to the pack's sounds, so they live
## beside them; the engine keeps only behaviour (buses, ducking, covers).
static var _sounds_json: Dictionary = {}
static var _sounds_loaded: bool = false


static func _table(key: String, fallback: Variant) -> Variant:
	if not _sounds_loaded:
		_sounds_loaded = true
		var f := FileAccess.open(ThemePack.audio_dir() + "sounds.json", FileAccess.READ)
		if f != null:
			var v: Variant = JSON.parse_string(f.get_as_text())
			if v is Dictionary:
				_sounds_json = v
	var t: Variant = _sounds_json.get(key, fallback)
	return t if typeof(t) == typeof(fallback) else fallback
const SETTINGS_PATH := "user://settings.json"
const POOL := 10

## Bus levels (dB): the owner's three knobs. VOLUME_DB below is the mix
## inside each bus.
const BUS_DB := {"Music": 3.0, "SFX": 3.0, "UI": 3.0}
## Bus of each sound id (base id; variants follow it). Anything else: SFX.
static var BUS_OF: Dictionary = _table("bus", {})

## Minimum seconds between two plays of the same sound (stops coin spam).
static var COOLDOWN: Dictionary = _table("cooldown", {})
## Feel track: "button_thunk" is skipped this soon after one of COVERS
## (play() / play_pitched() keys).
const COVERS := ["upgrade", "upgrade_p"]
const COVER_S := 0.05
## The four vehicle horns (Traffic picks one by vehicle): one cooldown, the
## "horn" one, for all of them.
static var HORN_IDS: Array = _table("horn_ids", [])

## Per-file volume (dB) for play(); a variant without its own entry uses its
## base id's. Set from tools/audio/measure.py so each sound lands at its
## target loudness (docs/polish/audio.md, "The mix").
static var VOLUME_DB: Dictionary = _table("volume_db", {})
## Volume (dB) for play_pitched() (waiter pickups, the deny buzz, reward
## count-up ticks, the LEVEL UP knock with its rising pitch). Ids not
## listed: -4 dB.
static var PITCHED_DB: Dictionary = _table("pitched_db", {})
## Largest random pitch change per id (callers ask for up to +-6 %): tonal
## sounds stay in tune with the music (key of D).
static var PITCH_JITTER_MAX: Dictionary = _table("pitch_jitter_max", {})
## Variants per id: [file id, weight]. (The horns are not variants any more:
## Traffic picks the vehicle's own horn, see HORN_IDS.)
static var VARIANTS: Dictionary = _table("variants", {})

## Music: fade in at boot, duck under Munshi-ji, quieter and darker at night.
const MUSIC_FADE_IN := 2.5
const DUCK_DB := -3.0
const DUCK_ATTACK := 0.35
const DUCK_RELEASE := 1.2
const NIGHT_MUSIC_DB := -4.0
const NIGHT_LPF_HZ := 4500.0
## Ambience bed (SFX bus): day (far highway, sparrows) crossfades to night
## (crickets) with the day / night cycle.
const AMB_FADE := 1.5
const LIMITER_CEILING_DB := -0.8

var sound_on := true
var music_on := true
var vibration_on := true

var _streams := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _last_played := {}
var _last_variant := {}
var _music: AudioStreamPlayer
var _amb_day: AudioStreamPlayer
var _amb_night: AudioStreamPlayer
var _bus := {}
var _lpf_idx := -1
var _music_t := 0.0
var _duck := 0.0
var _night := 0.0
var _amb_t := 0.0
var _applied := {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_settings()
	_setup_buses()
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_players.append(p)
	_music = _bed_player("music_loop", "Music")
	if _music.stream != null:
		_music.finished.connect(func(): if music_on: _music.play())
	_amb_day = _bed_player("amb_day", "SFX")
	_amb_night = _bed_player("amb_night", "SFX")
	_apply_music()
	_apply_sound_mute()


## Quit: stop every player and drop its stream so no playback outlives the
## audio server (the exit-time "AudioStreamPlaybackWAV leaked" report).
func _exit_tree() -> void:
	for p in _players:
		p.stop()
		p.stream = null
	for b in [_music, _amb_day, _amb_night]:
		if b != null:
			b.stop()
			b.stream = null
	_streams.clear()


# ================================================================ buses
func _setup_buses() -> void:
	for name in ["Music", "SFX", "UI"]:
		var i := AudioServer.get_bus_index(name)
		if i < 0:
			AudioServer.add_bus()
			i = AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, name)
			AudioServer.set_bus_send(i, "Master")
		_bus[name] = i
		AudioServer.set_bus_volume_db(i, float(BUS_DB[name]))
	# Night darkening on the music (off by day: no cost).
	var mi: int = _bus["Music"]
	var lpf := AudioEffectLowPassFilter.new()
	lpf.cutoff_hz = 20000.0
	AudioServer.add_bus_effect(mi, lpf)
	_lpf_idx = AudioServer.get_bus_effect_count(mi) - 1
	AudioServer.set_bus_effect_enabled(mi, _lpf_idx, false)
	# Master limiter (no clipping when many sounds land together).
	if ClassDB.class_exists("AudioEffectHardLimiter"):
		var lim: AudioEffect = ClassDB.instantiate("AudioEffectHardLimiter")
		lim.set("ceiling_db", LIMITER_CEILING_DB)
		AudioServer.add_bus_effect(0, lim)


func _bed_player(id: String, bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	p.volume_db = float(VOLUME_DB.get(id, 0.0))
	var s := _stream(id)
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	elif s is AudioStreamWAV and (s as AudioStreamWAV).loop_mode == AudioStreamWAV.LOOP_DISABLED:
		var w := s as AudioStreamWAV
		w.loop_begin = 0
		w.loop_end = int(roundf(w.get_length() * float(w.mix_rate)))
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
	p.stream = s
	add_child(p)
	return p


func _stream(id: String) -> AudioStream:
	if not _streams.has(id):
		var s: AudioStream = null
		for dir in [DIR, ThemePack.ENGINE_DIR + "audio/"]:
			for ext in [".ogg", ".wav"]:
				var path: String = str(dir) + id + ext
				if ResourceLoader.exists(path):
					s = load(path)
					break
			if s != null:
				break
		if s == null:
			print("[pack] missing sound '%s' (theme %s)" % [id, ThemePack.id()])
		_streams[id] = s
	return _streams[id]


# ================================================================ play
func play(id: String, pitch_jitter := 0.06) -> void:
	if not sound_on:
		return
	var now := Time.get_ticks_msec() / 1000.0
	var key: String = "horn" if HORN_IDS.has(id) else id
	if now - float(_last_played.get(key, -99.0)) < float(COOLDOWN.get(key, 0.03)):
		return
	if id == "button_thunk" and _covered(now):
		return
	_last_played[key] = now
	var file: String = _pick_variant(id)
	var s := _stream(file)
	if s == null:
		return
	var j: float = minf(pitch_jitter, float(PITCH_JITTER_MAX.get(id, pitch_jitter)))
	_start(s, _bus_of(id), float(VOLUME_DB.get(file, VOLUME_DB.get(id, 0.0))), 1.0 + randf_range(-j, j))


## Same as play() but with an exact pitch (used for rising pour ticks).
func play_pitched(id: String, pitch: float) -> void:
	if not sound_on:
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last_played.get(id + "_p", -99.0)) < 0.045:
		return
	_last_played[id + "_p"] = now
	var s := _stream(id)
	if s == null:
		return
	_start(s, _bus_of(id), float(PITCHED_DB.get(id, -4.0)), pitch)


## A free player if there is one, else the one that started longest ago.
func _start(s: AudioStream, bus: String, db: float, pitch: float) -> void:
	var p: AudioStreamPlayer = null
	for k in POOL:
		var q: AudioStreamPlayer = _players[(_next + k) % POOL]
		if not q.playing:
			p = q
			_next = (_next + k + 1) % POOL
			break
	if p == null:
		p = _players[_next]
		_next = (_next + 1) % POOL
	p.stream = s
	p.bus = bus
	p.volume_db = db
	p.pitch_scale = pitch
	p.play()


func _bus_of(id: String) -> String:
	return str(BUS_OF.get(id, "SFX"))


func _covered(now: float) -> bool:
	for c: String in COVERS:
		if now - float(_last_played.get(c, -99.0)) < COVER_S:
			return true
	return false


## Weighted pick among VARIANTS[id], never the same file twice in a row.
func _pick_variant(id: String) -> String:
	if not VARIANTS.has(id):
		return id
	var opts: Array = VARIANTS[id]
	var last: String = str(_last_variant.get(id, ""))
	var total := 0.0
	var w: Array[float] = []
	for o in opts:
		var f: String = str(o[0])
		var x: float = 0.0 if f == last else float(o[1])
		w.append(x)
		total += x
	var pick: String = str(opts[0][0])
	if total > 0.0:
		var r := randf() * total
		for i in opts.size():
			r -= w[i]
			if r <= 0.0:
				pick = str(opts[i][0])
				break
	_last_variant[id] = pick
	return pick


# ================================================================ per frame
func _process(delta: float) -> void:
	var dt: float = clampf(delta, 0.0, 0.1)
	var night_target := 0.0
	var duck_target := 0.0
	var refs: Node = get_node_or_null("/root/Refs")
	if refs != null:
		var sim: Object = refs.get("sim")
		if sim != null and is_instance_valid(sim):
			var nf: Variant = sim.get("night_f")
			if nf != null:
				night_target = clampf(float(nf), 0.0, 1.0)
		var dlg: Object = refs.get("dialogue")
		if dlg != null and is_instance_valid(dlg) and dlg.has_method("is_open"):
			duck_target = 1.0 if bool(dlg.call("is_open")) else 0.0
	_night = move_toward(_night, night_target, dt / 3.0)
	_duck = move_toward(_duck, duck_target, dt / (DUCK_ATTACK if duck_target > _duck else DUCK_RELEASE))
	if _music != null and _music.playing:
		_music_t = minf(_music_t + dt, MUSIC_FADE_IN)
	var fade: float = _music_t / MUSIC_FADE_IN
	var music_db: float = float(BUS_DB["Music"]) + DUCK_DB * _duck + NIGHT_MUSIC_DB * _night \
			+ (linear_to_db(maxf(fade * fade, 0.0001)) if fade < 1.0 else 0.0)
	_set_bus_db("Music", music_db)
	var mi: int = _bus.get("Music", -1)
	if mi >= 0 and _lpf_idx >= 0:
		var on: bool = _night > 0.02
		if on != bool(_applied.get("lpf_on", false)):
			_applied["lpf_on"] = on
			AudioServer.set_bus_effect_enabled(mi, _lpf_idx, on)
		if on:
			var hz: float = lerpf(16000.0, NIGHT_LPF_HZ, smoothstep(0.0, 1.0, _night))
			if absf(hz - float(_applied.get("lpf_hz", 0.0))) > 50.0:
				_applied["lpf_hz"] = hz
				var fx: AudioEffect = AudioServer.get_bus_effect(mi, _lpf_idx)
				if fx is AudioEffectLowPassFilter:
					(fx as AudioEffectLowPassFilter).cutoff_hz = hz
	_update_ambience(dt)


func _set_bus_db(bus: String, db: float) -> void:
	var i: int = _bus.get(bus, -1)
	if i < 0 or absf(db - float(_applied.get(bus, 999.0))) < 0.05:
		return
	_applied[bus] = db
	AudioServer.set_bus_volume_db(i, db)


## Day bed and night bed, crossfaded by the night factor; a bed that is
## silent is stopped (one Ogg decoder at a time most of the day and night).
func _update_ambience(dt: float) -> void:
	if _amb_day == null or _amb_night == null:
		return
	_amb_t = minf(_amb_t + dt, AMB_FADE)
	var on: bool = sound_on and _amb_t > 0.0
	var f: float = _amb_t / AMB_FADE
	var g_day: float = (1.0 - _night) * f
	var g_night: float = _night * f
	_bed(_amb_day, "amb_day", g_day, on)
	_bed(_amb_night, "amb_night", g_night, on)


func _bed(p: AudioStreamPlayer, id: String, gain: float, on: bool) -> void:
	if p.stream == null:
		return
	var want: bool = on and gain > 0.01
	if want and not p.playing:
		p.play(randf() * maxf(p.stream.get_length() - 1.0, 0.0))
	elif not want and p.playing:
		p.stop()
	if want:
		var db: float = float(VOLUME_DB.get(id, 0.0)) + linear_to_db(maxf(gain, 0.0001))
		if absf(db - p.volume_db) > 0.05:
			p.volume_db = db


# ================================================================ settings
func _haptics() -> Node:
	var fx: Node = get_node_or_null("/root/Fx")
	return fx.get_node_or_null("Haptics") if fx != null else null


func set_sound(on: bool) -> void:
	sound_on = on
	_apply_sound_mute()
	_save_settings()


func set_music(on: bool) -> void:
	music_on = on
	_apply_music()
	_save_settings()


func set_vibration(on: bool) -> void:
	vibration_on = on
	_save_settings()
	# Switched on: one tick, so the player feels what they turned on.
	if on:
		var h: Node = _haptics()
		if h != null:
			h.call("confirm")


func _apply_music() -> void:
	if _music == null or _music.stream == null:
		return
	if music_on and not _music.playing:
		_music_t = 0.0
		_music.play()
	elif not music_on:
		_music.stop()


func _apply_sound_mute() -> void:
	for b in ["SFX", "UI"]:
		var i: int = _bus.get(b, -1)
		if i >= 0:
			AudioServer.set_bus_mute(i, not sound_on)


func _load_settings() -> void:
	if not FileAccess.file_exists(SETTINGS_PATH):
		return
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.READ)
	var d = JSON.parse_string(f.get_as_text())
	if typeof(d) != TYPE_DICTIONARY:
		return
	sound_on = bool(d.get("sound", true))
	music_on = bool(d.get("music", true))
	vibration_on = bool(d.get("vibration", true))


func _save_settings() -> void:
	# Read-modify-write: other settings in the file (Loc's "lang") stay.
	var d: Dictionary = {}
	if FileAccess.file_exists(SETTINGS_PATH):
		var r := FileAccess.open(SETTINGS_PATH, FileAccess.READ)
		if r != null:
			var v: Variant = JSON.parse_string(r.get_as_text())
			if v is Dictionary:
				d = v
	d["sound"] = sound_on
	d["music"] = music_on
	d["vibration"] = vibration_on
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.WRITE)
	if f:
		f.store_string(JSON.stringify(d))
